# ETAPA 1: Build del binario Go
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Dependencias de build y swag para docs
RUN apk add --no-cache git
RUN go install github.com/swaggo/swag/cmd/swag@latest

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Generar Swagger y compilar binario estático Linux amd64
RUN swag init -g cmd/api/main.go -o docs
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /main cmd/api/main.go

# ETAPA 2: Runtime para Lambda con Lambda Web Adapter
FROM public.ecr.aws/docker/library/alpine:3.20

# Extension que traduce API Gateway -> servidor HTTP interno
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 /lambda-adapter /opt/extensions/lambda-adapter

# Binario de la app con ruta absoluta para evitar Runtime.InvalidEntrypoint
COPY --from=builder /main /main

ENV PORT=8080
EXPOSE 8080

ENTRYPOINT ["/main"]