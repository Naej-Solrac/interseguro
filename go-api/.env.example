# Seguridad JWT para firmar el token de login
JWT_SECRET=change_this_to_a_long_random_secret

# Credenciales de login del endpoint /api/v1/auth/login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=contraseñaDificil

# URL del servicio Node para estadisticas de matrices
# Local manual:   http://localhost:3000/api
# Docker compose: http://node-api:3000/api
NODE_SERVICE_URL=http://localhost:3000/api

# Origenes adicionales permitidos por CORS (separados por coma)
# Ejemplo: https://frontend-vue-rho.vercel.app,https://tu-otro-front.vercel.app
CORS_ALLOWED_ORIGINS=
